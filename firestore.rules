rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isParticipantByData() {
      return signedIn() && request.auth.uid in request.resource.data.participantes;
    }

    function isParticipant(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
    }

    match /usuarios/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);

      match /amigos/{amigoId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if signedIn() && (request.auth.uid == userId || request.auth.uid == amigoId);
      }

      match /solicitudes_recibidas/{solicitudId} {
        allow read: if isOwner(userId);
        allow create: if signedIn() && request.auth.uid == solicitudId;
        allow update: if false;
        allow delete: if signedIn() && (request.auth.uid == userId || request.auth.uid == solicitudId);
      }

      match /solicitudes_enviadas/{destinoId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if false;
        allow delete: if signedIn() && (request.auth.uid == userId || request.auth.uid == destinoId);
      }
    }

    match /publicaciones/{publicacionId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if signedIn() && request.auth.uid == resource.data.uid;

      match /likes/{likeId} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == likeId;
        allow update: if false;
      }

      match /comentarios/{comentarioId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == request.resource.data.uid;
        allow update, delete: if signedIn() && request.auth.uid == resource.data.uid;
      }
    }

    match /chats/{chatId} {
      allow read: if isParticipant(chatId) || isParticipantByData();
      allow create: if isParticipantByData();
      allow update, delete: if isParticipant(chatId);

      match /mensajes/{mensajeId} {
        allow read: if isParticipant(chatId);
        allow create: if isParticipant(chatId) && request.auth.uid == request.resource.data.emisor_uid;
        allow update, delete: if false;
      }
    }
  }
}
